{
  "name": "corkboard-desktop",
  "productName": "corkboard",
  "version": "1.10.0",
  "description": "corkboard for Windows: a desktop widget with your date, reminders and boards",
  "main": "main.cjs",
  "author": "Epinnn14",
  "license": "MIT",
  "private": true,
  "scripts": {
    "web": "node scripts/copy-web.cjs",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.epinnn14.corkboard",
    "productName": "corkboard",
    "copyright": "Epinnn14",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**",
      "build/tray*.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "corkboard.${ext}",
      "shortcutName": "corkboard",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
